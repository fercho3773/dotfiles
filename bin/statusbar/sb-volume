#!/usr/bin/env bash

# statusbar for volume
vol="$(amixer get Master| awk -F'[][]' '/%/{print $2; exit}' | tr -d '%')"
vmute="$(amixer get Master | grep -oE '\[(on|off)\]' | head -n1)"

# put some cool stuff here
#audio_stat=

case $BLOCK_BUTTON in
1) 
  command -v pavucontrol >/dev/null \
  && pavucontrol || st -e "alsamixer"
;;
3) 
  notify-send "Audio:" && \
  notify-send "audio_stat should go here" || exit
;;
esac

# this could be better ...
if [ "$vmute" = "[off]" ]; then
  echo "MUTE" && exit
elif [ "$vmute" = "[on]" ]; then
  if [ "$vol" -le 50 ];    then echo "v.$vol"
  elif [ "$vol" -le 100 ]; then echo "V.$vol"
else
    echo "X" && 
    notify-send "Check sound"
fi
