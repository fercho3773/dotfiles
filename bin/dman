#!/usr/bin/env  bash
set -euo pipefail

# open manpages from dmenu
#manpage=$(man . -k | dmenu -l 30 -p "Available manual pages:" | awk '{print $1}' | cut -d'(' -f1 | cut -d',' -f1')
manpage=$(man . -k | dmenu -l 30 -p "Available manual pages:" | awk '{print $1}' | awk '{sub(/[(,].*/, ""); print}')

if [[ $(command -v zathura) && $(command -v groff) ]] then
  notify-send "Viewing manual for $manpage."
  man -w $manpage | xargs -I {} groff -Tpdf -man {} | zathura -
else
  notify-send "Viewing manual for $manpage."
  $TERMINAL -e man "$(man -w $manpage)"
fi
